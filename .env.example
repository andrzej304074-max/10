# =============================================================================
#  Otodom → Meta Conversions API — zmienne środowiskowe
# =============================================================================
#
#  Lokalnie:  skopiuj ten plik do `.env.local` i uzupełnij wartości.
#             `.env.local` jest w .gitignore i NIGDY nie trafia do repozytorium.
#
#  Na Vercelu: Project → Settings → Environment Variables.
#             Zaznacz środowiska: Production + Preview + Development.
#             Po dodaniu zmiennych zrób redeploy — funkcje czytają je przy starcie.
#
#  ŻADNA z tych zmiennych NIE MOŻE mieć prefiksu NEXT_PUBLIC_ — taki prefiks
#  wypycha wartość do bundla przeglądarki, czyli publikuje sekret.
# =============================================================================


# -----------------------------------------------------------------------------
# META — wymagane zawsze
# -----------------------------------------------------------------------------

# Token systemowy z uprawnieniem `ads_management`.
# Gdzie go wziąć: business.facebook.com → Ustawienia firmy → Użytkownicy →
# Użytkownicy systemowi → [wybierz użytkownika] → Wygeneruj nowy token →
# zaznacz aplikację i uprawnienie `ads_management`. Token pokazuje się raz.
# Szczegóły w README, sekcja „Token systemowy”.
META_ACCESS_TOKEN=

# Identyfikator zestawu danych (dawniej: pixela). Same cyfry.
# Menedżer zdarzeń → Zestawy danych → kolumna „Identyfikator”.
META_DATASET_ID=

# Wersja Graph API. Zmieniaj świadomie — Meta wycofuje wersje po ok. 2 latach.
META_API_VERSION=v21.0

# Tryb testowy: gdy `true`, do każdego żądania dokładany jest `test_event_code`,
# a zdarzenia trafiają WYŁĄCZNIE do zakładki „Testowanie zdarzeń” i nie zasilają
# optymalizacji kampanii. Na produkcji ustaw `false` (albo usuń zmienną).
META_TEST_MODE=false

# Kod z Menedżera zdarzeń → Testowanie zdarzeń (format: TEST12345).
# Wymagany tylko wtedy, gdy META_TEST_MODE=true.
META_TEST_EVENT_CODE=


# -----------------------------------------------------------------------------
# BAZA DANYCH — wymagane zawsze
# -----------------------------------------------------------------------------

# Vercel Postgres (Neon). Zakładka Storage → Create Database → Postgres.
# Po podłączeniu do projektu Vercel sam doda tę zmienną.
# Lokalnie: `vercel env pull .env.local`.
POSTGRES_URL=


# -----------------------------------------------------------------------------
# WEBHOOK POCZTY PRZYCHODZĄCEJ — wymagane dla POST /api/inbound/email
# -----------------------------------------------------------------------------

# `resend` (domyślnie) albo `mailgun`.
INBOUND_PROVIDER=resend

# Sekret do weryfikacji podpisu webhooka:
#   • Resend  → Webhooks → [twój webhook] → Signing Secret (zaczyna się od `whsec_`)
#   • Mailgun → Sending → Webhooks → HTTP webhook signing key
INBOUND_WEBHOOK_SECRET=

# Tolerancja zegara przy weryfikacji podpisu, w sekundach (ochrona przed replay).
INBOUND_SIGNATURE_TOLERANCE_SECONDS=300


# -----------------------------------------------------------------------------
# CRON — wymagane dla GET /api/cron/poll-imap i POST /api/dev/send-test-lead
# -----------------------------------------------------------------------------

# Losowy sekret, min. 16 znaków:  openssl rand -hex 32
# Gdy ta zmienna jest ustawiona, Vercel Cron sam dokłada nagłówek
# `Authorization: Bearer <CRON_SECRET>` do swoich wywołań.
CRON_SECRET=


# -----------------------------------------------------------------------------
# IMAP — wymagane tylko dla ścieżki zapasowej (cron)
# -----------------------------------------------------------------------------
# Możesz je pominąć, jeśli korzystasz wyłącznie z webhooka. Cron wykryje brak
# konfiguracji, pominie odpytywanie skrzynki i nadal dokończy zaległe wysyłki.

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# Dla Gmaila: hasło aplikacji (myaccount.google.com → Bezpieczeństwo →
# Hasła do aplikacji), NIE hasło do konta.
IMAP_PASSWORD=
IMAP_SECURE=true
IMAP_MAILBOX=INBOX

# Ile maili maksymalnie przetworzyć w jednym przebiegu crona (limit czasu funkcji).
IMAP_MAX_MESSAGES_PER_RUN=25

# Jak daleko wstecz sięgać przy wyszukiwaniu wiadomości (godziny).
IMAP_LOOKBACK_HOURS=24


# -----------------------------------------------------------------------------
# PANEL /dashboard
# -----------------------------------------------------------------------------

# Min. 12 znaków. Służy też jako klucz podpisu ciasteczka sesji — zmiana hasła
# natychmiast unieważnia wszystkie zalogowane sesje.
DASHBOARD_PASSWORD=

# Ważność sesji panelu w godzinach.
DASHBOARD_SESSION_HOURS=12


# -----------------------------------------------------------------------------
# STROJENIE APLIKACJI — opcjonalne, wszystko ma wartości domyślne
# -----------------------------------------------------------------------------

# `event_source_url` używany, gdy w mailu nie ma linku do ogłoszenia.
# Wpisz tu adres swojego ogłoszenia na Otodom.
DEFAULT_EVENT_SOURCE_URL=https://www.otodom.pl/

# `custom_data.listing_id` używany, gdy nie da się wyciągnąć numeru ogłoszenia.
DEFAULT_LISTING_ID=unknown

# `custom_data.content_name` używany, gdy w mailu nie ma tytułu ogłoszenia.
DEFAULT_CONTENT_NAME=Hala produkcyjno-magazynowa Kraków

# Domyślny kraj przy normalizacji telefonu do E.164 (kod ISO 3166-1 alpha-2).
PHONE_DEFAULT_COUNTRY=PL

# Okno zaokrąglenia timestampu w `event_id` (sekundy). Większa wartość =
# skuteczniejsza deduplikacja tej samej wiadomości z dwóch źródeł.
EVENT_ID_BUCKET_SECONDS=300

# Retry klienta HTTP do Meta.
META_MAX_ATTEMPTS=5
META_TIMEOUT_MS=10000
META_RETRY_BASE_MS=500
META_RETRY_MAX_DELAY_MS=8000

# Dokańczanie zaległości przez cron.
PENDING_DRAIN_LIMIT=20
PENDING_RETRY_DELAY_SECONDS=120
PENDING_MAX_ATTEMPTS=15

# Poziom logowania: debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# REGUŁY ROZPOZNAWANIA MAILI — opcjonalne (to nie są sekrety)
# -----------------------------------------------------------------------------
# Wartości rozdzielone przecinkami. Puste = użyj wbudowanych wartości domyślnych
# z src/lib/config/patterns.ts.

# Domeny nadawców, których wiadomości przetwarzamy.
OTODOM_SENDER_DOMAINS=

# Fragmenty tematu kwalifikujące wiadomość (dopasowanie bez wielkości liter).
OTODOM_SUBJECT_PATTERNS=

# Domeny, których adresy NIE mogą zostać uznane za adres leada.
# Dopisz tu własny adres skrzynki, jeśli pojawia się w treści przekazanych maili.
OTODOM_EXCLUDED_EMAIL_DOMAINS=
